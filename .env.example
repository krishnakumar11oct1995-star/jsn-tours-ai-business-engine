# ==============================================================================
# Jai Srimannarayana Tours & Travels - Environment Configuration
# ==============================================================================

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended: gemini-2.5-flash or gemini-1.5-flash (or gemini-3.8-flash when supported by tier)
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API Configuration
# Custom verification token you enter in Meta App Dashboard > WhatsApp > Configuration
WHATSAPP_VERIFY_TOKEN=***REMOVED***
# Permanent or System User Access Token from Meta Developer Console
WHATSAPP_TOKEN=your_whatsapp_cloud_api_access_token
# WhatsApp Phone Number ID (from Meta Developer Console > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Database Configuration (SQLite by default; easily swapped to postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./pilgrimage_tours.db

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENABLE_DAILY_SCHEDULER=true

# Brand Context & Business Metadata
BUSINESS_NAME=Jai Srimannarayana Tours & Travels
BUSINESS_PHONE=9030780132
BUSINESS_LOCATION=Hyderabad, Telangana
YOUTUBE_CHANNEL=@telugutravellerramesh5846
REPRESENTATIVE_NAME=Ramesh
SITE_URL=https://jaisrimannarayana.netlify.app
CORE_PACKAGES=Chardham Yatra 2026, Kashi, Ayodhya, Naimisharanyam, Prayagraj Sangam
